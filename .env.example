# Copia este archivo a .env para desarrollo local.
# En Railway, define estas mismas variables en Variables del servicio.

# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esto

# True en local, False en Railway.
DEBUG=True

# PostgreSQL, obligatoria. En Railway se inyecta sola al enlazar el servicio
# de Postgres; no la copies a mano allá.
DATABASE_URL=postgresql://roadmap:roadmap_local@localhost:5432/roadmap
