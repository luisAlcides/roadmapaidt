# Copia este archivo a .env para desarrollo local (o configura las variables en Railway).

# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esto

# True en local, False en Railway.
DEBUG=True

# En Railway se inyecta sola al enlazar el servicio de Postgres.
# En local, si la omites, se usa SQLite.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos
